flowchart TB
  SLACK["Slack Socket Mode"]
  DISCORD["Discord poller"]
  TELEGRAM["Telegram poller"]
  SLACK --> MATCH
  DISCORD --> MATCH
  TELEGRAM --> MATCH
  MATCH{"Exact binding<br/>and mention gate?"}
  MATCH -->|no| DROP["Ignore"]
  MATCH -->|yes| POLICY["Binding policy<br/>tool allowlist · time budget · auto-response"]
  POLICY --> LANE["LaneQueue<br/>session → gateway → global"]
  LANE --> SESSION["SharedServices<br/>DAEMON session"]
  SESSION --> VISIBLE["AgenticLoop<br/>provider-neutral visible tools"]
  VISIBLE -->|tool call| EXEC["ToolExecutor<br/>allowlist + headless denylist"]
  EXEC -->|tool result| VISIBLE
  VISIBLE -->|final text| RESPOND{"auto_respond?"}
  RESPOND -->|yes| SEND["Post to channel thread"]
  RESPOND -->|no| SUPPRESS["Persist session<br/>suppress outbound text"]
