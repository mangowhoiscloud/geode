{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-claim-failure.schema.json",
  "title": "GEODE GEO claim extraction failure receipt v1",
  "type": "object",
  "required": ["schema_id", "observation_id", "producer", "version", "model", "effort", "failed_at", "native_receipt_sha256", "answer_sha256", "target_urls", "reason", "attempts"],
  "properties": {
    "schema_id": {"const": "geode.geo-claim-failure@1"},
    "observation_id": {"type": "string", "minLength": 3, "maxLength": 256},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "effort": {"type": "string", "minLength": 1, "maxLength": 32},
    "failed_at": {"type": "string", "format": "date-time"},
    "native_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "maxLength": 2000}
    },
    "reason": {"const": "invalid_model_output"},
    "attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["attempt", "response_sha256", "error"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
          "response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "error": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
