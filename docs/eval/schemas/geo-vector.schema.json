{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-vector.schema.json",
  "title": "GEODE GEO stage measurement vector v1",
  "type": "object",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["stage", "phase", "status", "numerator", "denominator", "finding", "evidence"],
      "properties": {
        "stage": {"enum": ["F", "R", "C", "P", "A", "Q", "O"]},
        "phase": {"enum": ["preflight", "live_observe", "experiment"]},
        "status": {"enum": ["not_measured", "partial", "measured"]},
        "numerator": {"type": ["integer", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 1},
        "finding": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_measured"}}},
          "then": {
            "properties": {
              "numerator": {"type": "null"},
              "denominator": {"type": "null"},
              "evidence": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "numerator": {"type": "integer", "minimum": 0},
              "denominator": {"type": "integer", "minimum": 1},
              "evidence": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "primary_metric": {
      "type": "object",
      "required": ["name", "numerator", "denominator", "unit"],
      "properties": {
        "name": {"enum": ["clicks-per-impression", "referrals-per-impression", "engaged-sessions-per-referral", "conversions-per-session"]},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "schema_version", "run_id", "run_spec_sha256", "workload_sha256", "native_results_sha256", "verifier_results_sha256", "native_producer", "verifier_context", "preflight_context", "outcome_context", "outcome_primary_metric", "observations", "search_activation", "quality_claim_coverage", "vector"],
  "properties": {
    "schema_id": {"const": "geode.geo-vector@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "run_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "native_results_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verifier_results_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "native_producer": {
      "type": "object",
      "required": ["adapter", "provider", "credential_source", "model"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "credential_source": {"enum": ["payg", "subscription"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "verifier_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["producer", "version", "model", "rubric"],
          "properties": {
            "producer": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "model": {"type": "string", "minLength": 1, "maxLength": 128},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "rubric": {"$ref": "#/$defs/evidence_ref"}
          },
          "additionalProperties": false
        }
      ]
    },
    "claim_extractor_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["producer", "version", "model"],
          "properties": {
            "producer": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "model": {"type": "string", "minLength": 1, "maxLength": 128},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      ]
    },
    "calibration_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "sha256", "reviewer", "blinded_to_verifier_labels", "reviewed_observations", "claim_universe_completeness", "support_agreement"],
          "properties": {
            "path": {"type": "string", "minLength": 1, "maxLength": 1000},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
            "blinded_to_verifier_labels": {"const": true},
            "reviewed_observations": {"type": "integer", "minimum": 1},
            "claim_universe_completeness": {"$ref": "#/$defs/ratio"},
            "support_agreement": {"$ref": "#/$defs/ratio"}
          },
          "additionalProperties": false
        }
      ]
    },
    "preflight_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["site", "links", "host"],
          "properties": {
            "site": {"$ref": "#/$defs/evidence_ref"},
            "links": {"$ref": "#/$defs/evidence_ref"},
            "host": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_ref"}]}
          },
          "additionalProperties": false
        }
      ]
    },
    "outcome_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_ref"}]},
    "outcome_primary_metric": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/primary_metric"}]},
    "observations": {
      "type": "object",
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"type": "integer", "minimum": 1},
        "observed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "search_activation": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "quality_claim_coverage": {
      "type": "object",
      "required": ["audited_claims", "audited_target_cited_responses", "target_cited_responses"],
      "properties": {
        "audited_claims": {"type": "integer", "minimum": 0},
        "audited_target_cited_responses": {"type": "integer", "minimum": 0},
        "target_cited_responses": {"type": "integer", "minimum": 0},
        "unmeasured_target_cited_responses": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "vector": {
      "type": "object",
      "required": ["F", "R", "C", "P", "A", "Q", "O"],
      "properties": {
        "F": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "F"}}}]},
        "R": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "R"}}}]},
        "C": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "C"}}}]},
        "P": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "P"}}}]},
        "A": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "A"}}}]},
        "Q": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "Q"}}}]},
        "O": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"stage": {"const": "O"}}}]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
