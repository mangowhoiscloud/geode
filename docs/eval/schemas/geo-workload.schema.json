{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-workload.schema.json",
  "title": "GEODE GEO frozen workload v1",
  "type": "object",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "profile",
    "observation_mode",
    "frozen_at",
    "engine",
    "model",
    "locale",
    "account_state",
    "repetitions",
    "requested_result_limit",
    "live_approval_receipt",
    "target_prefixes",
    "items"
  ],
  "properties": {
    "schema_id": {"const": "geode.geo-workload@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "profile": {"const": "geo-visibility-v1"},
    "observation_mode": {"enum": ["offline", "live"]},
    "frozen_at": {"type": "string", "format": "date-time"},
    "engine": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35},
    "account_state": {"type": "string", "minLength": 1, "maxLength": 256},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 1000},
    "requested_result_limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "live_approval_receipt": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_ref"}]
    },
    "target_prefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "maxLength": 1000}
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "root_id", "kind", "query"],
        "properties": {
          "id": {"type": "string", "pattern": "^GEO-0[1-6]\\.(root|p[1-3])$"},
          "root_id": {"type": "string", "pattern": "^GEO-0[1-6]$"},
          "kind": {"enum": ["root", "paraphrase"]},
          "query": {"type": "string", "minLength": 3, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"observation_mode": {"const": "live"}}},
      "then": {"properties": {"repetitions": {"const": 5}}}
    }
  ]
}
