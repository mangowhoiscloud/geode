{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-host-preflight-v2.schema.json",
  "title": "GEODE public-host fetch preflight v2",
  "type": "object",
  "$defs": {
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["sitemap_parity", "http_2xx", "html", "redirect_identity", "self_canonical", "indexable", "robots_allowed", "content_parity", "eligible"],
      "properties": {
        "sitemap_parity": {"type": "boolean"},
        "http_2xx": {"type": "boolean"},
        "html": {"type": "boolean"},
        "redirect_identity": {"type": "boolean"},
        "self_canonical": {"type": "boolean"},
        "indexable": {"type": "boolean"},
        "robots_allowed": {"type": "boolean"},
        "content_parity": {"type": "boolean"},
        "eligible": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "schema_version", "status", "generated_at", "base_url", "sitemap_url", "urlset_sha256", "observed_urlset_sha256", "sitemap_difference", "robots", "checks", "pages"],
  "properties": {
    "schema_id": {"const": "geode.geo-host-preflight@2"},
    "schema_version": {"const": 2},
    "status": {"enum": ["pass", "fail"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "base_url": {"type": "string", "format": "uri", "maxLength": 1000},
    "sitemap_url": {"type": "string", "format": "uri", "maxLength": 1000},
    "urlset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_urlset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sitemap_difference": {
      "type": "object",
      "required": ["missing", "unexpected", "duplicates"],
      "properties": {
        "missing": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2000}},
        "unexpected": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2000}},
        "duplicates": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2000}}
      },
      "additionalProperties": false
    },
    "robots": {
      "type": "object",
      "required": ["url", "status", "policy", "user_agents"],
      "properties": {
        "url": {"type": "string", "format": "uri", "maxLength": 1000},
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "policy": {"enum": ["allow-by-absence", "parsed"]},
        "user_agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["sitemap_parity", "http_2xx", "html", "redirect_identity", "self_canonical", "indexable", "robots_allowed", "content_parity", "eligible"],
      "properties": {
        "sitemap_parity": {"$ref": "#/$defs/ratio"},
        "http_2xx": {"$ref": "#/$defs/ratio"},
        "html": {"$ref": "#/$defs/ratio"},
        "redirect_identity": {"$ref": "#/$defs/ratio"},
        "self_canonical": {"$ref": "#/$defs/ratio"},
        "indexable": {"$ref": "#/$defs/ratio"},
        "robots_allowed": {"$ref": "#/$defs/ratio"},
        "content_parity": {"$ref": "#/$defs/ratio"},
        "eligible": {"$ref": "#/$defs/ratio"}
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "final_url", "status_code", "content_type", "x_robots_tag", "local_sha256", "deployed_sha256", "robots_allowed", "checks", "failures"],
        "properties": {
          "url": {"type": "string", "format": "uri", "maxLength": 2000},
          "final_url": {"type": "string", "format": "uri", "maxLength": 2000},
          "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
          "content_type": {"type": "string", "minLength": 1, "maxLength": 256},
          "x_robots_tag": {"type": "string", "maxLength": 1000},
          "local_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "deployed_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "robots_allowed": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
          "checks": {"$ref": "#/$defs/checks"},
          "failures": {"type": "array", "uniqueItems": true, "items": {"enum": ["sitemap_parity", "http_2xx", "html", "redirect_identity", "self_canonical", "indexable", "robots_allowed", "content_parity"]}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
