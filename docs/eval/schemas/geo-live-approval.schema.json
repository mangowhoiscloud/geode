{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-live-approval.schema.json",
  "title": "GEODE GEO operator live approval v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "approval_id",
    "run_id",
    "operator",
    "approved_at",
    "engine",
    "model",
    "locale",
    "account_state",
    "repetitions",
    "requested_result_limit"
  ],
  "properties": {
    "schema_id": {"const": "geode.geo-live-approval@1"},
    "schema_version": {"const": 1},
    "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,255}$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "operator": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_at": {"type": "string", "format": "date-time"},
    "engine": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35},
    "account_state": {"type": "string", "minLength": 1, "maxLength": 256},
    "repetitions": {"const": 5},
    "requested_result_limit": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "additionalProperties": false
}
