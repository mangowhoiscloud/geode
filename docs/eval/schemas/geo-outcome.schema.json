{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-outcome.schema.json",
  "title": "GEODE GEO first-party outcome receipt v1",
  "type": "object",
  "required": ["schema_id", "schema_version", "run_id", "workload_sha256", "collected_at", "window", "source", "primary_metric"],
  "properties": {
    "schema_id": {"const": "geode.geo-outcome@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "workload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["system", "property"],
      "properties": {
        "system": {"enum": ["search-console", "referral-analytics", "conversion-analytics"]},
        "property": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "primary_metric": {
      "type": "object",
      "required": ["name", "numerator", "denominator", "unit"],
      "properties": {
        "name": {"enum": ["clicks-per-impression", "referrals-per-impression", "engaged-sessions-per-referral", "conversions-per-session"]},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
