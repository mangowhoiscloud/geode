{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-native-results.schema.json",
  "title": "GEODE GEO native observation index v1",
  "type": "object",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "ranked_url": {
      "type": "object",
      "required": ["url", "rank"],
      "properties": {
        "url": {"type": "string", "format": "uri", "maxLength": 2000},
        "rank": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "visible_citation": {
      "type": "object",
      "required": ["url", "visible_rank"],
      "properties": {
        "url": {"type": "string", "format": "uri", "maxLength": 2000},
        "visible_rank": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "run_spec_sha256",
    "workload_sha256",
    "collected_at",
    "producer",
    "preflight_context",
    "observations"
  ],
  "properties": {
    "schema_id": {"const": "geode.geo-native-results@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "run_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "collected_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "required": ["adapter", "provider", "credential_source", "model"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "credential_source": {"enum": ["payg", "subscription"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "preflight_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["site", "links", "host"],
          "properties": {
            "site": {"$ref": "#/$defs/evidence_ref"},
            "links": {"$ref": "#/$defs/evidence_ref"},
            "host": {
              "oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence_ref"}]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "workload_id",
          "repetition",
          "query",
          "engine",
          "model",
          "locale",
          "account_state",
          "observed_at",
          "search_activated",
          "retrieval",
          "citations",
          "native_receipt",
          "native_source_locator"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,255}$"
          },
          "workload_id": {
            "type": "string",
            "pattern": "^GEO-0[1-6]\\.(root|p[1-3])$"
          },
          "repetition": {"type": "integer", "minimum": 1, "maximum": 1000},
          "query": {"type": "string", "minLength": 3, "maxLength": 1000},
          "engine": {"type": "string", "minLength": 1, "maxLength": 128},
          "model": {"type": "string", "minLength": 1, "maxLength": 128},
          "locale": {"type": "string", "minLength": 2, "maxLength": 35},
          "account_state": {"type": "string", "minLength": 1, "maxLength": 256},
          "observed_at": {"type": "string", "format": "date-time"},
          "search_activated": {"type": "boolean"},
          "retrieval": {
            "oneOf": [
              {"type": "null"},
              {"type": "array", "items": {"$ref": "#/$defs/ranked_url"}}
            ]
          },
          "citations": {
            "type": "array",
            "items": {"$ref": "#/$defs/visible_citation"}
          },
          "native_receipt": {"$ref": "#/$defs/evidence_ref"},
          "native_source_locator": {
            "type": "object",
            "required": [
              "query",
              "engine",
              "model",
              "locale",
              "account_state",
              "observed_at",
              "search_activated",
              "retrieval",
              "citations"
            ],
            "properties": {
              "query": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "engine": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "model": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "locale": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "account_state": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "observed_at": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "search_activated": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "retrieval": {"type": "string", "pattern": "^/", "maxLength": 1000},
              "citations": {"type": "string", "pattern": "^/", "maxLength": 1000}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
