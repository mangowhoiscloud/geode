{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-claim-universe.schema.json",
  "title": "GEODE GEO frozen claim universe v1",
  "type": "object",
  "required": ["schema_id", "observation_id", "producer", "version", "model", "effort", "extracted_at", "native_receipt_sha256", "answer_sha256", "target_urls", "claims", "rationale"],
  "properties": {
    "schema_id": {"const": "geode.geo-claim-universe@1"},
    "observation_id": {"type": "string", "minLength": 3, "maxLength": 256},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "effort": {"type": "string", "minLength": 1, "maxLength": 32},
    "extracted_at": {"type": "string", "format": "date-time"},
    "native_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "maxLength": 2000}
    },
    "claims": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["claim_id", "answer_quote", "answer_start", "answer_end"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim-[0-9]{3}$"},
          "answer_quote": {"type": "string", "minLength": 1, "maxLength": 2000},
          "answer_start": {"type": "integer", "minimum": 0},
          "answer_end": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "additionalProperties": false
}
