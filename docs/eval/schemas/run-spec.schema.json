{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/run-spec.schema.json",
  "title": "GEODE evaluation run specification v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "created_at",
    "preregistration",
    "study",
    "reproduction",
    "artifacts",
    "privacy"
  ],
  "properties": {
    "schema_id": {"const": "geode.eval-run-spec@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "preregistration": {
      "type": "object",
      "required": ["mode", "status", "frozen_at", "live_test_approved", "operator"],
      "properties": {
        "mode": {"enum": ["prospective", "retrospective"]},
        "status": {"const": "frozen"},
        "frozen_at": {"type": "string", "format": "date-time"},
        "live_test_approved": {"type": "boolean"},
        "operator": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "study": {
      "type": "object",
      "required": [
        "research_question",
        "research_gap",
        "hypothesis",
        "primary_metric",
        "decision_rule",
        "invalidation_rule",
        "analysis_plan"
      ],
      "properties": {
        "research_question": {"type": "string", "minLength": 10, "maxLength": 2000},
        "research_gap": {"type": "string", "minLength": 10, "maxLength": 2000},
        "hypothesis": {"type": "string", "minLength": 10, "maxLength": 2000},
        "primary_metric": {
          "type": "object",
          "required": ["name", "unit", "direction", "aggregation", "denominator"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "unit": {"type": "string", "minLength": 1, "maxLength": 64},
            "direction": {"enum": ["maximize", "minimize", "target"]},
            "aggregation": {"type": "string", "minLength": 1, "maxLength": 256},
            "denominator": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        },
        "decision_rule": {"type": "string", "minLength": 10, "maxLength": 2000},
        "invalidation_rule": {"type": "string", "minLength": 10, "maxLength": 2000},
        "analysis_plan": {"type": "string", "minLength": 10, "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "required": ["geode", "harness", "model", "environment", "execution", "comparison"],
      "properties": {
        "geode": {
          "type": "object",
          "required": ["revision", "branch", "dirty"],
          "properties": {
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "branch": {"type": "string", "minLength": 1, "maxLength": 160},
            "dirty": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "harness": {
          "type": "object",
          "required": ["name", "source", "revision"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "source": {"type": "string", "minLength": 1, "maxLength": 512},
            "revision": {"type": "string", "minLength": 1, "maxLength": 160}
          },
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "required": ["provider", "label", "route", "reasoning"],
          "properties": {
            "provider": {"type": "string", "minLength": 1, "maxLength": 80},
            "label": {"type": "string", "minLength": 1, "maxLength": 128},
            "route": {"enum": ["subscription", "api", "local", "none", "other"]},
            "reasoning": {"type": "string", "minLength": 1, "maxLength": 80}
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "required": ["platform", "architecture", "reset_strategy", "initial_state_ref"],
          "properties": {
            "platform": {"type": "string", "minLength": 1, "maxLength": 160},
            "architecture": {"type": "string", "minLength": 1, "maxLength": 80},
            "reset_strategy": {"type": "string", "minLength": 1, "maxLength": 512},
            "initial_state_ref": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": [
            "command_redacted",
            "ordered_workload_ids",
            "workload_ids_sha256",
            "repetitions",
            "seed_schedule",
            "max_concurrency",
            "timeout_seconds",
            "budget"
          ],
          "properties": {
            "command_redacted": {"type": "string", "minLength": 1, "maxLength": 4000},
            "ordered_workload_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "workload_ids_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "repetitions": {"type": "integer", "minimum": 1},
            "seed_schedule": {
              "type": "array",
              "minItems": 1,
              "items": {"type": ["integer", "string"]}
            },
            "max_concurrency": {"type": "integer", "minimum": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "budget": {
              "type": "object",
              "required": ["kind", "limit", "unit"],
              "properties": {
                "kind": {"enum": ["wall-time", "tokens", "cost", "subscription", "combined"]},
                "limit": {"type": ["number", "null"], "minimum": 0},
                "unit": {"type": "string", "minLength": 1, "maxLength": 64}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "comparison": {
          "type": "object",
          "required": ["claim_class", "comparator", "comparability", "promotion_authority"],
          "properties": {
            "claim_class": {
              "enum": [
                "smoke",
                "suite-headline",
                "paired-runtime",
                "paper-reference",
                "regression",
                "diagnostic"
              ]
            },
            "comparator": {"type": ["string", "null"], "maxLength": 512},
            "comparability": {"enum": ["direct", "directional", "not-comparable"]},
            "promotion_authority": {
              "enum": ["none", "suite-native", "paired-runtime", "release-gate"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "native_results",
        "trajectory",
        "verifier_receipts",
        "attempts",
        "analysis",
        "publication_manifest"
      ],
      "properties": {
        "native_results": {"type": ["string", "null"], "maxLength": 512},
        "measurement_results": {"type": ["string", "null"], "maxLength": 512},
        "trajectory": {"type": ["string", "null"], "maxLength": 512},
        "verifier_receipts": {"type": ["string", "null"], "maxLength": 512},
        "outcome_receipts": {"type": ["string", "null"], "maxLength": 512},
        "attempts": {"type": "string", "minLength": 1, "maxLength": 512},
        "analysis": {"type": "string", "minLength": 1, "maxLength": 512},
        "publication_manifest": {"type": ["string", "null"], "maxLength": 512}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["classification", "redaction_boundary"],
      "properties": {
        "classification": {"enum": ["public", "internal", "withheld"]},
        "redaction_boundary": {"type": "string", "minLength": 10, "maxLength": 2000}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
