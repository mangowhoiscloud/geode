{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-verifier-receipt-v2.schema.json",
  "title": "GEODE GEO fixed-claim verifier receipt v2",
  "type": "object",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "quality_row": {
      "type": "object",
      "required": ["claim_id", "answer_quote", "answer_start", "answer_end", "source_url", "source_quote", "source_start", "source_end", "supported", "reason"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim-[0-9]{3}$"},
        "answer_quote": {"type": "string", "minLength": 1, "maxLength": 2000},
        "answer_start": {"type": "integer", "minimum": 0},
        "answer_end": {"type": "integer", "minimum": 1},
        "source_url": {"type": ["string", "null"], "format": "uri", "maxLength": 2000},
        "source_quote": {"type": "string", "maxLength": 2000},
        "source_start": {"type": ["integer", "null"], "minimum": 0},
        "source_end": {"type": ["integer", "null"], "minimum": 1},
        "supported": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "observation_id", "producer", "model", "verified_at", "rubric_sha256", "claim_universe_sha256", "sources", "absorption", "quality", "quality_claims_expected", "rationale"],
  "properties": {
    "schema_id": {"const": "geode.geo-verifier-receipt@2"},
    "observation_id": {"type": "string", "minLength": 3, "maxLength": 256},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "verified_at": {"type": "string", "format": "date-time"},
    "rubric_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claim_universe_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "absorption": {"type": "boolean"},
    "quality": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/quality_row"}},
    "quality_claims_expected": {"type": "integer", "minimum": 0, "maximum": 64},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "additionalProperties": false
}
