{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/publication.schema.json",
  "title": "GEODE evaluation artifact publication manifest v1",
  "type": "object",
  "required": [
    "artifact_repository",
    "entries",
    "geode",
    "publication",
    "run_id",
    "schema",
    "verification"
  ],
  "properties": {
    "artifact_repository": {
      "type": "object",
      "required": ["base_revision", "destination_prefix", "url"],
      "properties": {
        "base_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "destination_prefix": {"type": "string", "minLength": 1, "maxLength": 1024},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bytes", "classification", "local_path", "remote_path", "sha256"],
        "properties": {
          "bytes": {"type": "integer", "minimum": 0},
          "classification": {
            "enum": [
              "public",
              "withheld-private",
              "withheld-sealed",
              "private-secret",
              "reproducible-cache"
            ]
          },
          "local_path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
          "remote_path": {"type": ["string", "null"], "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"classification": {"const": "public"}}},
            "then": {"properties": {"remote_path": {"type": "string", "minLength": 1}}},
            "else": {
              "required": ["reason"],
              "properties": {"remote_path": {"type": "null"}}
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "geode": {
      "type": "object",
      "required": ["repository", "revision", "run_record"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "run_record": {"type": "string", "pattern": "^docs/eval/[^/]+\\.md$"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "object"},
    "publication": {
      "type": "object",
      "required": ["artifact_merge_revision", "published_at", "status"],
      "properties": {
        "artifact_merge_revision": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$"
        },
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "remote_readback": {
          "type": "object",
          "required": ["bytes_verified", "files_verified", "status", "verified_at"],
          "properties": {
            "bytes_verified": {"type": "integer", "minimum": 0},
            "files_verified": {"type": "integer", "minimum": 1},
            "status": {"const": "passed"},
            "verified_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "status": {"enum": ["prepared", "published"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "prepared"}}},
          "then": {
            "properties": {
              "artifact_merge_revision": {"type": "null"},
              "published_at": {"type": "null"}
            }
          },
          "else": {
            "required": ["remote_readback"],
            "properties": {
              "artifact_merge_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "published_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "schema": {"const": "geode.eval-artifact-publication.v1"},
    "verification": {
      "type": "object",
      "required": ["local_identity_scrubbed", "secret_scan_passed", "source_hashes_verified"],
      "properties": {
        "local_identity_scrubbed": {"type": "boolean"},
        "secret_scan_passed": {"type": "boolean"},
        "source_hashes_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"publication": {"properties": {"status": {"const": "published"}}}}},
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "local_identity_scrubbed": {"const": true},
              "secret_scan_passed": {"const": true},
              "source_hashes_verified": {"const": true}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
