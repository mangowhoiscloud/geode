{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-host-preflight.schema.json",
  "title": "GEODE public-host fetch preflight v1",
  "type": "object",
  "$defs": {
    "ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "schema_version", "status", "generated_at", "base_url", "sitemap_url", "urlset_sha256", "observed_urlset_sha256", "sitemap_difference", "robots", "checks"],
  "properties": {
    "schema_id": {"const": "geode.geo-host-preflight@1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["pass", "fail"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "base_url": {"type": "string", "format": "uri", "maxLength": 1000},
    "sitemap_url": {"type": "string", "format": "uri", "maxLength": 1000},
    "urlset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_urlset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sitemap_difference": {
      "type": "object",
      "required": ["missing", "unexpected", "duplicates"],
      "properties": {
        "missing": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2000}},
        "unexpected": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2000}},
        "duplicates": {"type": "array", "items": {"type": "string", "format": "uri", "maxLength": 2000}}
      },
      "additionalProperties": false
    },
    "robots": {
      "type": "object",
      "required": ["url", "status", "policy"],
      "properties": {
        "url": {"type": "string", "format": "uri", "maxLength": 1000},
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "policy": {"enum": ["allow-by-absence", "parsed"]}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["sitemap_parity", "http_2xx", "html", "self_canonical", "indexable", "robots_allowed"],
      "properties": {
        "sitemap_parity": {"$ref": "#/$defs/ratio"},
        "http_2xx": {"$ref": "#/$defs/ratio"},
        "html": {"$ref": "#/$defs/ratio"},
        "self_canonical": {"$ref": "#/$defs/ratio"},
        "indexable": {"$ref": "#/$defs/ratio"},
        "robots_allowed": {"$ref": "#/$defs/ratio"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
