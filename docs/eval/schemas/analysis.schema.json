{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/analysis.schema.json",
  "title": "GEODE evaluation analysis v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "analyzed_at",
    "run_spec_sha256",
    "attempts_sha256",
    "selected_attempt_ids",
    "answer",
    "metrics",
    "decision",
    "limitations",
    "evidence_refs"
  ],
  "properties": {
    "schema_id": {"const": "geode.eval-analysis@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "analyzed_at": {"type": "string", "format": "date-time"},
    "run_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempts_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_attempt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
    },
    "answer": {"type": "string", "minLength": 10, "maxLength": 8000},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "numerator",
          "denominator",
          "unit",
          "source_ref",
          "source_locator"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "value": {"type": ["number", "string"]},
          "numerator": {"type": ["number", "null"]},
          "denominator": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "unit": {"type": "string", "minLength": 1, "maxLength": 64},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 512},
          "source_locator": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["value", "numerator", "denominator"],
                "properties": {
                  "value": {
                    "oneOf": [
                      {"type": "null"},
                      {"type": "string", "pattern": "^/", "maxLength": 512}
                    ]
                  },
                  "numerator": {"type": "string", "pattern": "^/", "maxLength": 512},
                  "denominator": {"type": "string", "pattern": "^/", "maxLength": 512}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": ["outcome", "hypothesis_status", "rationale"],
      "properties": {
        "outcome": {"enum": ["promote", "reject", "inconclusive", "diagnostic-only"]},
        "hypothesis_status": {"enum": ["supported", "not-supported", "mixed", "invalidated"]},
        "rationale": {"type": "string", "minLength": 10, "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": ["native-result", "measurement", "trajectory", "verifier-receipt", "outcome-receipt", "error", "other"]
          },
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
