{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/docs/eval/schemas/geo-verifier-results.schema.json",
  "title": "GEODE GEO verifier overlay v1",
  "type": "object",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "schema_version", "run_id", "native_results_sha256", "verified_at", "verifier_context", "observations"],
  "properties": {
    "schema_id": {"const": "geode.geo-verifier-results@1"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "native_results_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "verifier_context": {
      "type": "object",
      "required": ["producer", "version", "rubric"],
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "rubric": {"$ref": "#/$defs/evidence_ref"}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["observation_id", "absorption", "quality", "quality_claims_expected", "verifier_receipt"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 3, "maxLength": 256},
          "absorption": {"type": "boolean"},
          "quality": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["claim_id", "source_url", "supported"],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1, "maxLength": 256},
                "source_url": {"type": "string", "format": "uri", "maxLength": 2000},
                "supported": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "quality_claims_expected": {"type": "integer", "minimum": 1},
          "verifier_receipt": {"$ref": "#/$defs/evidence_ref"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
