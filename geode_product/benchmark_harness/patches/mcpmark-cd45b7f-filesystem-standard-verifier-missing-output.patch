From: GEODE evaluation maintainers
Subject: [PATCH] Make missing filesystem outputs ordinary verifier failures

MCPMark-Upstream-Revision: cd45b7f57923b9b3985467f5139927575f83141c
Preimage-Git-Blob: tasks/filesystem/standard/desktop/project_management/verify.py 1f28a6a7a8b435a2ebfbef85f5b132e2fccf484f
Preimage-Git-Blob: tasks/filesystem/standard/file_context/duplicates_searching/verify.py c7a26ad9ce2fe5fb92079bcfd8755afdc5051ede
Preimage-Git-Blob: tasks/filesystem/standard/file_context/file_splitting/verify.py 5f72271a6a4038ddf450c6c27b2e89214d4e253e

The filesystem/standard verifier runs every check even after a directory
existence check fails. Guard the four dependent directory scans so a missing
or wrong-type agent output returns the existing semantic FAIL instead of an
uncaught FileNotFoundError or NotADirectoryError. Successful behavior is
unchanged.

diff --git a/tasks/filesystem/standard/desktop/project_management/verify.py b/tasks/filesystem/standard/desktop/project_management/verify.py
index 1f28a6a..6304199 100644
--- a/tasks/filesystem/standard/desktop/project_management/verify.py
+++ b/tasks/filesystem/standard/desktop/project_management/verify.py
@@ -194,2 +194,5 @@ def verify_progress_tracking_empty(test_dir: Path) -> bool:
     organized_dir = test_dir / "organized_projects"
+    if not (organized_dir / "learning" / "progress_tracking").is_dir():
+        print("❌ progress_tracking directory not found or is not a directory")
+        return False
     progress_dir = organized_dir / "learning" / "progress_tracking"
@@ -235,2 +238,5 @@ def verify_file_counts(test_dir: Path) -> bool:
     for dir_path, expected_count in expected_counts.items():
+        if not (organized_dir / dir_path).is_dir():
+            incorrect_counts.append(f"{dir_path}: missing or not a directory")
+            continue
         full_path = organized_dir / dir_path
diff --git a/tasks/filesystem/standard/file_context/duplicates_searching/verify.py b/tasks/filesystem/standard/file_context/duplicates_searching/verify.py
index c7a26ad..6360c29 100644
--- a/tasks/filesystem/standard/file_context/duplicates_searching/verify.py
+++ b/tasks/filesystem/standard/file_context/duplicates_searching/verify.py
@@ -163,2 +163,5 @@ def verify_total_file_count(test_dir: Path) -> bool:
     """Verify that the duplicates directory contains exactly 14 files."""
+    if not (test_dir / "duplicates").is_dir():
+        print("❌ duplicates directory not found or is not a directory")
+        return False
     duplicates_dir = test_dir / "duplicates"
diff --git a/tasks/filesystem/standard/file_context/file_splitting/verify.py b/tasks/filesystem/standard/file_context/file_splitting/verify.py
index 5f72271..4ef98ba 100644
--- a/tasks/filesystem/standard/file_context/file_splitting/verify.py
+++ b/tasks/filesystem/standard/file_context/file_splitting/verify.py
@@ -111,2 +111,5 @@ def verify_no_extra_files(test_dir: Path) -> bool:
     """Verify that no extra files exist in the split directory."""
+    if not (test_dir / "split").is_dir():
+        print("❌ split directory not found or is not a directory")
+        return False
     split_dir = test_dir / "split"
