{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/core/observability/schemas/run-event.schema.json",
  "title": "GEODE run event v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "event_id",
    "occurred_at",
    "ordinal",
    "session_id",
    "turn_id",
    "call_id",
    "component",
    "level",
    "kind",
    "actor_type",
    "actor_id",
    "action",
    "payload"
  ],
  "properties": {
    "schema_id": {"const": "geode.run-event@1"},
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "number"},
    "ordinal": {"type": "integer", "minimum": 0},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "turn_id": {"type": "string", "maxLength": 256},
    "call_id": {"type": "string", "maxLength": 256},
    "gen_tag": {"type": "string"},
    "component": {"type": "string", "minLength": 1},
    "level": {"type": "string"},
    "kind": {"type": "string", "minLength": 1},
    "actor_type": {"type": "string"},
    "actor_id": {"type": "string"},
    "action": {"type": "string"},
    "entity_type": {"type": "string"},
    "entity_id": {"type": "string"},
    "task_id": {"type": "string"},
    "payload": {"type": "object"},
    "ts": {"type": "number"},
    "seq": {"type": "integer", "minimum": 0},
    "event": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
