{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/core/observability/schemas/trajectory-release.schema.json",
  "title": "GEODE trajectory release manifest v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "producer_schema_id",
    "release_source",
    "release_scope",
    "published_at",
    "supersedes",
    "admission",
    "privacy_review",
    "files",
    "quality"
  ],
  "properties": {
    "schema_id": {"const": "geode.trajectory-release@1"},
    "schema_version": {"const": 1},
    "producer_schema_id": {"const": "geode.trajectory@1"},
    "release_source": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_scope": {"type": "string", "minLength": 1, "maxLength": 256},
    "published_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "admission": {
      "type": "object",
      "required": [
        "scope_complete_required",
        "replay_complete_required",
        "privacy_review_required"
      ],
      "properties": {
        "scope_complete_required": {"const": true},
        "replay_complete_required": {"type": "boolean"},
        "privacy_review_required": {"const": true}
      },
      "additionalProperties": false
    },
    "privacy_review": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewed_at",
        "method",
        "scope",
        "attestation",
        "record_sha256"
      ],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1, "maxLength": 128},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "attestation": {"type": "string", "minLength": 1, "maxLength": 2048},
        "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256",
          "records",
          "trajectory_id",
          "scope_complete",
          "replay_complete",
          "complete"
        ],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/].*\\.json$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "records": {"type": "integer", "minimum": 0},
          "trajectory_id": {"type": "string", "minLength": 1},
          "scope_complete": {"type": "boolean"},
          "replay_complete": {"type": "boolean"},
          "complete": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "schema_valid",
        "integrity_recomputed",
        "trajectory_ids_unique",
        "privacy_reviewed",
        "scope_complete_trajectories",
        "scope_incomplete_trajectories",
        "replay_complete_trajectories",
        "replay_incomplete_trajectories",
        "complete_trajectories",
        "incomplete_trajectories",
        "trajectory_events",
        "evidence_refs",
        "runtime_event_refs",
        "secret_scan",
        "source_digest_refs",
        "source_digests_verified",
        "remote_readback_required"
      ],
      "properties": {
        "schema_valid": {"const": true},
        "integrity_recomputed": {"const": true},
        "trajectory_ids_unique": {"const": true},
        "privacy_reviewed": {"type": "boolean"},
        "scope_complete_trajectories": {"type": "integer", "minimum": 0},
        "scope_incomplete_trajectories": {"type": "integer", "minimum": 0},
        "replay_complete_trajectories": {"type": "integer", "minimum": 0},
        "replay_incomplete_trajectories": {"type": "integer", "minimum": 0},
        "complete_trajectories": {"type": "integer", "minimum": 0},
        "incomplete_trajectories": {"type": "integer", "minimum": 0},
        "trajectory_events": {"type": "integer", "minimum": 0},
        "evidence_refs": {"type": "integer", "minimum": 0},
        "runtime_event_refs": {"type": "integer", "minimum": 0},
        "secret_scan": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "source_digest_refs": {"type": "integer", "minimum": 0},
        "source_digests_verified": {"type": "integer", "minimum": 0},
        "remote_readback_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
