{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mangowhoiscloud/geode/main/core/observability/schemas/session-event.schema.json",
  "title": "GEODE session event v1",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "ordinal",
    "event_id",
    "occurred_at",
    "session_id",
    "session_generation",
    "turn_id",
    "call_id",
    "kind",
    "payload",
    "payload_hash",
    "source"
  ],
  "properties": {
    "schema_id": {"const": "geode.session-event@1"},
    "schema_version": {"const": 1},
    "ordinal": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "number"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "session_generation": {"type": "integer", "minimum": 1},
    "turn_id": {"type": "string", "maxLength": 256},
    "call_id": {"type": "string", "maxLength": 256},
    "parent_event_id": {"type": ["string", "null"], "maxLength": 256},
    "kind": {
      "enum": [
        "session.started",
        "session.ended",
        "turn.completed",
        "verification.decided",
        "verification.continued",
        "verification.evidence",
        "verification.pending",
        "plan.created",
        "plan.progressed",
        "plan.replanned",
        "plan.abandoned",
        "plan.completed",
        "goal.created",
        "goal.updated",
        "goal.continued",
        "grill.started",
        "grill.updated",
        "grill.completed",
        "geo.started",
        "geo.updated",
        "geo.completed",
        "message.user",
        "message.assistant",
        "tool.called",
        "tool.completed",
        "subagent.started",
        "subagent.stopped",
        "artifact.saved",
        "usage.recorded",
        "error.recorded",
        "gui.step",
        "preflight.recorded",
        "handoff.triggered",
        "legacy.imported"
      ]
    },
    "role": {"type": "string", "maxLength": 32},
    "status": {"type": "string", "maxLength": 32},
    "model": {"type": "string", "maxLength": 256},
    "provider": {"type": "string", "maxLength": 128},
    "payload": {"type": "object"},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "string", "minLength": 1, "maxLength": 64},
    "corrupt_payload": {"type": "boolean"}
  },
  "additionalProperties": false
}
