# GEODE Gateway Configuration
#
# 이 파일을 .geode/config.toml로 복사한 뒤 채널 ID를 입력하세요.
# config.toml은 .gitignore에 의해 추적되지 않습니다 (개인정보 보호).

# ---------------------------------------------------------------------------
# Gateway 전역 설정
# ---------------------------------------------------------------------------
[gateway]
enabled = true
pollers = ["slack"]
time_budget_s = 120   # 메시지당 wall-clock 예산 (초)
max_turns = 20        # 스레드당 대화 이력 최대 턴 수
# 원격 desktop control은 기본 차단. 제한된 채널에서 의도적으로 허용할 때만 true.
allow_computer_use = false

# ---------------------------------------------------------------------------
# 채널 바인딩
# ---------------------------------------------------------------------------
# 채널 ID 확인법: Slack 채널 → 채널명 클릭 → 맨 아래 "Channel ID" 복사
#
# 옵션:
#   auto_respond    — 메시지 수신 시 자동 응답 (true/false)
#   require_mention — @멘션 필수 여부 (true: 멘션 시에만 응답)
#   allowed_tools   — 이 채널에서 모델과 실행기에 허용할 도구 이름
#   time_budget_s   — 이 채널의 메시지당 wall-clock 예산 (전역값 오버라이드)

[[gateway.bindings.rules]]
channel = "slack"
channel_id = "C0XXXXXXXXX"  # 채널 ID
auto_respond = true
require_mention = true
# allowed_tools = ["memory_search", "web_fetch"]
# time_budget_s = 90  # 생략 시 [gateway] 전역값 사용
